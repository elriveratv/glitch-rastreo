RewriteEngine On

# Si el subdominio es específico de rastreo (ej. rastreo.tecycom.mx), mostrar rastreo.html por defecto
<If "%{HTTP_HOST} =~ /rastreo/">
    DirectoryIndex rastreo.html index.html
</If>
<Else>
    DirectoryIndex index.html rastreo.html
</Else>

# URLs limpias sin .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^rastreo/?$ rastreo.html [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^seguimiento/?$ rastreo.html [L,QSA]
